{
  "name": "@slimelab-ai/openai-custom-stt",
  "version": "0.1.0",
  "description": "OpenClaw media-understanding plugin for OpenAI-compatible speech-to-text with configurable remote host",
  "type": "module",
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "providers": [
      "openai-custom-stt"
    ],
    "install": {
      "minHostVersion": ">=2026.4.4"
    },
    "compat": {
      "pluginApi": ">=2026.4.4",
      "minGatewayVersion": "2026.4.4"
    },
    "build": {
      "openclawVersion": "2026.4.4",
      "pluginSdkVersion": "2026.4.4"
    }
  },
  "peerDependencies": {
    "openclaw": ">=2026.4.4"
  }
}
